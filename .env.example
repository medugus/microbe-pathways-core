# Public build-time variables. These are safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_MEDUGU_PUBLIC_BASE_URL=https://lims.example.com
VITE_ZONE_READER_PUBLIC_URL=https://reader.example.com
# Prelaunch default is no-login mode. Set to true when Supabase Auth users are ready.
VITE_MEDUGU_REQUIRE_AUTH=false
# Optional: address used by the IPC "Notify IPC" mail draft button.
VITE_MEDUGU_IPC_EMAIL=ipc@hospital.example

# Server runtime variables. Put these in Cloudflare Worker variables/secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
ZONE_READER_INBOUND_TOKEN=64-character-shared-zone-reader-token
ZONE_READER_TENANT_ID=your-lab-tenant-uuid
ZONE_READER_ALLOWED_ORIGIN=https://medugu-zone-reader.nubwa-medugu.workers.dev

# Optional AI assistance. Leave disabled until an API key is configured.
AI_ASSIST_ENABLED=0
AI_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini

# Optional server-side validation feature gate.
PHASE5_SERVER_VALIDATION=0
